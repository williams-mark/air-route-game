{
  "name": "@arg/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Air Route Game desktop shell (Electron)",
  "author": "Air Route Game",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build:app": "pnpm --filter @arg/app build",
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs --dev",
    "smoke": "node scripts/start.mjs --smoke",
    "dist": "pnpm run build:app && pnpm run build && electron-builder --win dir --config electron-builder.yml",
    "steam:upload": "node scripts/steam-upload.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  }
}
